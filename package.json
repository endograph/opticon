{
  "name": "opticon",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "opticon": "bun apps/cli/src/main.ts",
    "dev": "OPTICON_DEV=1 bun --watch apps/cli/src/main.ts daemon",
    "convex": "bun scripts/convex-local.ts --watch"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
