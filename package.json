{
  "name": "opticon",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "opticon": "bun apps/cli/src/main.ts",
    "dev": "OPTICON_DEV=1 bun --watch apps/cli/src/main.ts daemon",
    "convex": "bun scripts/convex-local.ts --watch",
    "e2e": "bun scripts/e2e-share.ts",
    "deploy:web": "bun run --filter @opticon/web build:hosted && cd apps/web && bunx wrangler@4.147.0 pages deploy dist-hosted --project-name opticon --branch main"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
